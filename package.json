{
  "name": "erdos",
  "version": "1.4.0",
  "description": "ErdOS \u2014 hyperaddictive Phosphor Glass desktop for Windows, macOS, and Linux",
  "main": "electron/main.js",
  "author": {
    "name": "ErdOS",
    "email": "erdos@localhost"
  },
  "license": "MIT",
  "homepage": "https://github.com/ErdTheTurd/ERDOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErdTheTurd/ERDOS.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "website": "npx --yes serve website -p 4173",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.erdos.desktop",
    "productName": "ErdOS",
    "copyright": "Copyright \u00a9 2026 ErdOS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "website",
        "to": "website",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ErdOS",
      "artifactName": "ErdOS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ErdOS-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "ErdOS-${version}-mac.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "ErdOS ${version}",
      "artifactName": "ErdOS-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "System",
      "artifactName": "ErdOS-${version}.${ext}",
      "desktop": {
        "Name": "ErdOS",
        "Comment": "ErdOS Desktop Environment",
        "Categories": "System;Utility;"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ErdTheTurd",
        "repo": "ERDOS",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}
